# Copy this file to .env.local in the private cPanel Application root.
# Replace CPANEL_USERNAME with the actual account name before running anything.
# Do not copy the development computer's .env.local or publish credentials in Git.
NODE_ENV=production
SITE_URL=https://elitasocial.ir
CMS_ORIGIN=https://elitasocial.ir
SITE_INDEXING=false
CMS_DATA_DIR=/home/CPANEL_USERNAME/elita-data

# Leave DEPLOY_TARGET and NEXT_PUBLIC_BASE_PATH unset on this root-domain deployment.
# Keep the data directory outside public_html and outside the code upload directory.

# Fresh database only: uncomment and fill these privately before running cms:init.
# With a restored database, keep the existing account and run cms:migrate instead.
# CMS_ADMIN_EMAIL=your-private-admin-email@example.com
# CMS_ADMIN_NAME=Elita Administrator
# CMS_ADMIN_PASSWORD=CHOOSE_A_NEW_PRIVATE_PASSWORD_WITH_LETTERS_AND_NUMBERS
