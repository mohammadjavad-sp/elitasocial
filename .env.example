# Run the full application on Node.js 22.19 or newer.
# Leave DEPLOY_TARGET and NEXT_PUBLIC_BASE_PATH unset on the Node host.
# Use an absolute path on the host's persistent disk in production.
CMS_DATA_DIR=.data

# Optional locally; set this to the public HTTPS origin on your Node host.
# Do not include a path or trailing slash.
# CMS_ORIGIN=https://elitasocial.ir

# Public SEO origin only: no path, query or fragment. Set on the final Node host.
# NEXT_PUBLIC_BASE_PATH, when present, is added once by the SEO helpers.
# SITE_URL=https://elitasocial.ir
# Keep previews unindexed. Enable only after the final domain/content are ready.
SITE_INDEXING=false

# Initial administrator, used only by npm run cms:init.
# Never commit real credentials. Create .env.local or use host environment variables.
# CMS_ADMIN_EMAIL=admin@example.com
# CMS_ADMIN_NAME=Elita administrator
# CMS_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
